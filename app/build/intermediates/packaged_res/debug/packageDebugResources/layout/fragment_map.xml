<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 🧭 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@android:color/white"
        android:elevation="2dp">

        <!-- 왼쪽 텍스트 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="배고픈 송이들의 모임"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="SOOKPLE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A2FA0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 오른쪽 영역: 로그아웃 위, 룰렛(배지) 아래 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <!-- 로그아웃 -->
            <TextView
                android:id="@+id/logoutBtn"
                android:text="로그아웃"
                android:textSize="14sp"
                android:textColor="#1A2FA0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end" />

            <!-- 룰렛 버튼: 로그아웃 아래에 위치 -->
            <TextView
                android:id="@+id/rouletteBtn"
                android:text="🎯 룰렛"
                android:textSize="12sp"
                android:textColor="#1A2FA0"
                android:background="@drawable/bg_badge_outline"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:elevation="4dp"/>

        </LinearLayout>
    </LinearLayout>


    <!-- 🗺 지도 + 리스트 전체 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="80dp"
        android:layout_marginTop="64dp">

        <!-- 지도 영역 -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#E8EBF9">

            <com.naver.maps.map.MapView
                android:id="@+id/naverMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>
        <!-- 💙 My Place 리스트 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="-24dp"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 헤더 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/heart"
                    app:tint="#1A2FA0"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My Place"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_up"
                    app:tint="#1A2FA0" />
            </LinearLayout>

            <!-- 숙명 한식당 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_outline_card"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineProvider="background"
                android:padding="12dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_food_image" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="숙명 한식당"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/star"
                            app:tint="#FFD700" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="4.5"
                            android:textColor="#444444"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="· 한식 · 3분 거리"
                            android:textColor="#777777"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_small"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="파트너십"
                    android:textColor="#1A2FA0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 피자 마루 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_outline_card"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineProvider="background"
                android:padding="12dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_food_image" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="피자 마루"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/star"
                            app:tint="#FFD700" />

                        <TextView
                            android:layout_width="2dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:text="4.7"
                            android:textColor="#444444"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="· 양식 · 7분 거리"
                            android:textColor="#777777"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_small"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="파트너십"
                    android:textColor="#1A2FA0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 🧭 하단 네비게이션바 -->
    <LinearLayout
        android:id="@+id/bottomNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- 아이콘 줄 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <ImageView
                android:id="@+id/homeTap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/home_icon"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <ImageView
                android:id="@+id/searchTap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/search_icon"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <ImageView
                android:id="@+id/mapTap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/map_icon"
                android:scaleType="centerInside"
                android:padding="6dp"
                app:tint="#1A2FA0"/>

            <ImageView
                android:id="@+id/communityTap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/community_icon"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <ImageView
                android:id="@+id/mypageTap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/my_page_icon"
                android:scaleType="centerInside"
                android:padding="6dp" />
        </LinearLayout>

        <!-- 텍스트 줄 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView
                android:text="홈"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:text="검색"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:text="지도"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#1A2FA0"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:text="커뮤니티"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:text="마이페이지"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>



</FrameLayout>
    <!-- 룰렛 버튼: 하단 네비게이션 위 오른쪽에 띄우기 -->
