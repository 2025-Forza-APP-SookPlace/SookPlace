<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- 제목 -->
    <TextView
        android:text="🎲 뭐 먹을까? 룰렛"
        android:textColor="#1A2FA0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- 부제 -->
    <TextView
        android:text="룰렛 옵션을 선택하세요"
        android:textColor="#777777"
        android:textSize="14sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <!-- 옵션 1: My Place에서 랜덤 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_outline_card"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person"
            android:tint="#1A2FA0"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="My Place에서 랜덤"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#000000" />

            <TextView
                android:text="저장한 맛집 중에서 선택"
                android:textSize="13sp"
                android:textColor="#777777" />
        </LinearLayout>
    </LinearLayout>

    <!-- 옵션 2: 랜덤 메뉴 카테고리 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_outline_card"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_dashboard_black_24dp"
            android:tint="#1A2FA0"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="랜덤 메뉴 카테고리"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#000000" />

            <TextView
                android:text="음식 종류를 랜덤으로 추천"
                android:textSize="13sp"
                android:textColor="#777777" />
        </LinearLayout>
    </LinearLayout>

    <!-- 옵션 3: TOP 20 맛집에서 랜덤 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_outline_card"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/star"
            android:tint="#1A2FA0"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="TOP 20 맛집에서 랜덤"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#000000" />

            <TextView
                android:text="인기 맛집 중에서 선택"
                android:textSize="13sp"
                android:textColor="#777777" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>