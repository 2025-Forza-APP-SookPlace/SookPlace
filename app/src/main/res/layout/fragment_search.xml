<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.search.SearchFragment">

        <!--컨텐츠-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--건색창-->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                app:elevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:contentInsetStart="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@drawable/background_radius_gray"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/search_icon"
                            app:tint="#8E8E93" />

                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="맛집을 찾아보세요"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivClear"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/close"
                            android:visibility="gone" />
                    </LinearLayout>

                </com.google.android.material.appbar.MaterialToolbar>
            </com.google.android.material.appbar.AppBarLayout>

            <!--식당종류-->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="65dp"
                app:layout_constraintBottom_toTopOf="@+id/bottomNav"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <!--카테고리로 검색-->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:scrollbars="none">

                        <RadioGroup
                            android:layout_width="wrap_content"
                            android:layout_height="80dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/foodCategory_Btn0"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:background="@drawable/selector_food_category"
                                android:button="@null"
                                android:fontFamily="@font/smu_snowflake_regular"
                                android:gravity="center"
                                android:text="전체"
                                android:textSize="14sp"
                                android:textColor="@color/selector_food_text_color" />

                            <RadioButton
                                android:id="@+id/foodCategory_Btn1"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:background="@drawable/selector_food_category"
                                android:button="@null"
                                android:fontFamily="@font/smu_snowflake_regular"
                                android:gravity="center"
                                android:text="치킨"
                                android:textSize="14sp"
                                android:textColor="@color/selector_food_text_color" />

                            <RadioButton
                                android:id="@+id/foodCategory_Btn2"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:background="@drawable/selector_food_category"
                                android:button="@null"
                                android:fontFamily="@font/smu_snowflake_regular"
                                android:gravity="center"
                                android:text="카페"
                                android:textSize="14sp"
                                android:textColor="@color/selector_food_text_color" />

                            <RadioButton
                                android:id="@+id/foodCategory_Btn3"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:background="@drawable/selector_food_category"
                                android:button="@null"
                                android:fontFamily="@font/smu_snowflake_regular"
                                android:gravity="center"
                                android:text="한식"
                                android:textSize="14sp"
                                android:textColor="@color/selector_food_text_color" />

                            <RadioButton
                                android:id="@+id/foodCategory_Btn4"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:background="@drawable/selector_food_category"
                                android:button="@null"
                                android:fontFamily="@font/smu_snowflake_regular"
                                android:gravity="center"
                                android:text="분식"
                                android:textSize="14sp"
                                android:textColor="@color/selector_food_text_color" />

                            <RadioButton
                                android:id="@+id/foodCategory_Btn5"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:background="@drawable/selector_food_category"
                                android:button="@null"
                                android:fontFamily="@font/smu_snowflake_regular"
                                android:gravity="center"
                                android:text="양식"
                                android:textSize="14sp"
                                android:textColor="@color/selector_food_text_color" />

                            <RadioButton
                                android:id="@+id/foodCategory_Btn6"
                                android:layout_width="80dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:background="@drawable/selector_food_category"
                                android:button="@null"
                                android:fontFamily="@font/smu_snowflake_regular"
                                android:gravity="center"
                                android:text="디저트"
                                android:textSize="14sp"
                                android:textColor="@color/selector_food_text_color" />
                        </RadioGroup>
                    </HorizontalScrollView>

                    <!--검색정렬-->

                    <RadioGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/sortPopular"
                            android:layout_width="80dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:background="@drawable/selector_food_category"
                            android:button="@null"
                            android:fontFamily="@font/smu_snowflake_regular"
                            android:gravity="center"
                            android:text="인기순"
                            android:textSize="14sp"
                            android:checked="true"
                            android:textColor="@color/selector_food_text_color" />

                        <RadioButton
                            android:id="@+id/sortNear"
                            android:layout_width="80dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:background="@drawable/selector_food_category"
                            android:button="@null"
                            android:fontFamily="@font/smu_snowflake_regular"
                            android:gravity="center"
                            android:text="가까운순"
                            android:textSize="14sp"
                            android:textColor="@color/selector_food_text_color" />

                        <RadioButton
                            android:id="@+id/sortRate"
                            android:layout_width="80dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:background="@drawable/selector_food_category"
                            android:button="@null"
                            android:fontFamily="@font/smu_snowflake_regular"
                            android:gravity="center"
                            android:text="평점순"
                            android:textSize="14sp"
                            android:textColor="@color/selector_food_text_color" />

                    </RadioGroup>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/search_rv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:listitem="@layout/search_rv_item"/>
                </LinearLayout>

            </ScrollView>

            <!--하단바-->
            <LinearLayout
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="#FFFFFF"
                android:weightSum="5"
                app:layout_constraintBottom_toTopOf="@+id/linearLayout">

                <ImageView
                    android:id="@+id/homeTap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="10dp"
                    android:src="@drawable/home_icon" />

                <ImageView
                    android:id="@+id/searchTap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="10dp"
                    android:src="@drawable/search_icon"
                    app:tint="@color/smblue" />

                <ImageView
                    android:id="@+id/mapTap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="10dp"
                    android:src="@drawable/map_icon" />

                <ImageView
                    android:id="@+id/communityTap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="10dp"
                    android:src="@drawable/cummunity_icon" />

                <ImageView
                    android:id="@+id/mypageTap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="10dp"
                    android:src="@drawable/my_page_icon" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="#FFFFFF"
                android:weightSum="5"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="1"
                    android:text="홈"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="탐색"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="지도"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="커뮤니티"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="마이페이지"
                    android:textAlignment="center" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</layout>