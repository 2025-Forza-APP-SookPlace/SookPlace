<?xml version="1.0" encoding="utf-8"?>
<layout>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.search.restaurantDetail.RestaurantDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/arrow_back"
                android:contentDescription="뒤로가기"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="맛집 상세"
                android:textAlignment="center"
                android:textColor="@color/smblue"
                android:textSize="18sp"
                android:fontFamily="@font/smu_snowflake_bold"/>

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- IMAGE SLIDER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/imageMain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvImageIndex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/background_radius_gray"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="1 / 5" />

            </FrameLayout>

            <!-- Like & Save -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageButton
                    android:id="@+id/btnLike"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/background_radius"
                    android:contentDescription="좋아요"
                    android:src="@drawable/favorite" />

                <ImageButton
                    android:id="@+id/btnSave"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/background_radius"
                    android:contentDescription="마이플레이스"
                    android:src="@drawable/location" />
            </LinearLayout>

            <!-- Pagination dots -->
            <LinearLayout
                android:id="@+id/sliderDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp" />
        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dividerHeight="12dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- RESTAURANT INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textRestaurantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="6dp"
                    android:text="숙명 한식당"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/smu_snowflake_bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/star"
                        app:tint="#FFB800"/>

                    <TextView
                        android:id="@+id/textRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:text="4.5"
                        android:textSize="14sp"
                        android:fontFamily="@font/smu_snowflake_regular"/>

                    <TextView
                        android:id="@+id/textCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/background_radius_gray"
                        android:padding="4dp"
                        android:text="한식"
                        android:textColor="@color/smblue"
                        android:textSize="14sp"
                        android:fontFamily="@font/smu_snowflake_regular"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CONTACT INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/location"
                        app:tint="@color/black"/>

                    <TextView
                        android:id="@+id/textAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:text="숙명여대 정문 앞"
                        android:textSize="14sp"
                        android:fontFamily="@font/smu_snowflake_regular"/>

                    <TextView
                        android:id="@+id/btnNaverMap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="네이버지도"
                        android:textColor="@color/smblue"
                        android:textSize="14sp"
                        android:fontFamily="@font/smu_snowflake_regular"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/clock" />

                    <TextView
                        android:id="@+id/textHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:text="월-금 11:00-21:00, 토-일 12:00-20:00"
                        android:textSize="14sp"
                        android:fontFamily="@font/smu_snowflake_regular"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/phone" />

                    <TextView
                        android:id="@+id/textPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:text="02-123-4567"
                        android:textSize="14sp"
                        android:fontFamily="@font/smu_snowflake_regular"/>
                </LinearLayout>
            </LinearLayout>

            <!-- MENU -->
            <LinearLayout
                android:id="@+id/cardMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/background_radius"
                android:orientation="vertical"
                android:padding="16dp"
                app:cardCornerRadius="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="대표 메뉴"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/smu_snowflake_regular"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMenus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>


            <!-- RELATED POSTS -->
            <LinearLayout
                android:id="@+id/cardPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/background_radius"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이 맛집 후기"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/smu_snowflake_regular"/>

                <LinearLayout
                    android:id="@+id/postList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp" />

                <TextView
                    android:id="@+id/btnMoreReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:text="더 많은 후기 보기"
                    android:textColor="@color/smblue"
                    android:textSize="14sp"
                    android:fontFamily="@font/smu_snowflake_regular"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>


</ScrollView>
</layout>