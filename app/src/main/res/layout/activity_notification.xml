<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingBottom="70dp">

        <!-- 상단 헤더 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFFFF"
            android:paddingHorizontal="16dp"
            android:padding="16dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/ivBack"
                android:src="@drawable/ic_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="뒤로가기"
                app:tint="#1A2FA0" />

            <TextView
                android:id="@+id/textNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="알림 설정"
                android:textColor="#1A2FA0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- ⚙설정 항목 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp"
            android:backgroundTint="#FFFFFFFF"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true"
            app:cardPreventCornerOverlap="true">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="?android:attr/dividerHorizontal"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- 푸시 알림 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="푸시 알림"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF000000"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="앱 알림을 받습니다"
                                android:textSize="13sp"
                                android:textColor="#FF444444"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchPush"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#1A2FA0"
                            android:trackTint="#1A2FA0"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- 댓글 알림 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="댓글 알림"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF000000"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="내 게시글에 댓글이 달리면 알려드립니다"
                                android:textSize="13sp"
                                android:textColor="#FF444444"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchComments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#1A2FA0"
                            android:trackTint="#1A2FA0"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- 좋아요 알림 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="좋아요 알림"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF000000"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="게시글에 좋아요가 달리면 알려드립니다"
                                android:textSize="13sp"
                                android:textColor="#FF444444"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchLikes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:thumbTint="#1A2FA0"
                            android:trackTint="#1A2FA0"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- 맛집 추천 알림 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="맛집 추천 알림"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF000000"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="주변 맛집 추천을 받습니다"
                                android:textSize="13sp"
                                android:textColor="#FF444444"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchRecommendations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#1A2FA0"
                            android:trackTint="#1A2FA0"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

        </com.google.android.material.card.MaterialCardView>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="변경 사항은 자동 저장됩니다."
            android:textColor="#777777"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>