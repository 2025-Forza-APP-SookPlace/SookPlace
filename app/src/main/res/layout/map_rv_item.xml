<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_radius"
        android:padding="10dp"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/thumbnailUrl"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/background_radius_gray"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/food_img"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/smu_snowflake_bold"
            android:text="숙명 식당"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/thumbnailUrl"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/LinearLayout1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@+id/thumbnailUrl"
            app:layout_constraintTop_toBottomOf="@id/name">

            <ImageView
                android:id="@+id/star"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/star"
                app:tint="#FFB800" />

            <TextView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/smu_snowflake_regular"
                android:text="4.7"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="•" />

            <TextView
                android:id="@+id/category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_radius_gray"
                android:fontFamily="@font/smu_snowflake_regular"
                android:text="category"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="•" />

            <TextView
                android:id="@+id/distanceMinutesFromCampus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/smu_snowflake_regular"
                android:text="7분 거리"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@+id/thumbnailUrl" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>